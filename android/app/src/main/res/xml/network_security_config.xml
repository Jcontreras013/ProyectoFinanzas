<?xml version="1.0" encoding="utf-8"?>
<!-- Permite HTTP sin cifrar solo hacia el alias del host del emulador (10.0.2.2),
     donde corre el backend en desarrollo. Cualquier otro dominio requiere HTTPS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
