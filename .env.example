# Variables para docker-compose. Copia este archivo a .env y ajusta los valores
# antes de desplegar más allá de tu máquina local.

POSTGRES_DB=contafin
POSTGRES_USER=contafin
POSTGRES_PASSWORD=contafin_dev

# Genera un secreto real y largo antes de usar esto fuera de tu equipo local.
JWT_SECRET=dev-only-secret-change-me-please-32-bytes-min

# Origen(es) permitidos para CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173
