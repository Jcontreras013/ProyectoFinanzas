# Base URL de la API backend. Por defecto usa una ruta relativa ("/api/v1"),
# que funciona tanto con el proxy de desarrollo de Vite (ver vite.config.ts)
# como en producción si el frontend se sirve detrás del mismo host que el backend.
# Descomenta y ajusta solo si el backend vive en otro origen.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
